# ==============================================================================
# Full-Stack Monorepo Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env before starting services:
#   cp .env.example .env
#
# NOTE: Never commit sensitive passwords or production secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# Target environment (development | test | production)
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE CONFIGURATION (Used by Docker Compose & Database Client)
# ------------------------------------------------------------------------------
# Database credentials and database name
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=codeslot
POSTGRES_PORT=5432

# Database host:
# - 'postgres' when running inside Docker Compose service network
# - 'localhost' when connecting from host machine (e.g., local Prisma CLI)
POSTGRES_HOST=postgres

# Database Connection URLs:
# Used by backend service inside Docker network:
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/codeslot?schema=public

# Used by backend running directly on host machine (outside Docker):
DATABASE_URL_LOCAL=postgresql://postgres:postgres@localhost:5432/codeslot?schema=public

# ------------------------------------------------------------------------------
# 3. BACKEND API SERVICE CONFIGURATION
# ------------------------------------------------------------------------------
# Port for the Express backend server
BACKEND_PORT=5000
PORT=5000
HOST=0.0.0.0

# Logging verbosity (fatal | error | warn | info | debug | trace)
LOG_LEVEL=info

# Cross-Origin Resource Sharing (allowed client origins)
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. FRONTEND APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Port for the Vite frontend development server
FRONTEND_PORT=3000

# Base URL for frontend client requests to the backend API
# - 'http://localhost:5000/api' for browser requests from client machine
VITE_API_URL=http://localhost:5000/api

# Google Gemini API Key for AI Resume Studio
# (Keep empty or provide your key for testing Gemini AI integration)
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here
