# Backend Environment Variables (.env.example)

# Runtime Environment (development | test | production)
NODE_ENV=development

# Server Port and Host Binding
PORT=5000
HOST=0.0.0.0

# Logging Level (fatal | error | warn | info | debug | trace | silent)
LOG_LEVEL=info

# Cross-Origin Resource Sharing (Frontend URL)
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database Connection String
# Inside Docker Network (Docker Compose):
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/codeslot?schema=public

# Local Machine (Outside Docker, connecting to published PostgreSQL port):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codeslot?schema=public
