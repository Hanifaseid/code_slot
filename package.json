{
  "name": "codeslot-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"frontend,backend\" -c \"cyan,green\" \"pnpm --filter @code-slot/frontend dev\" \"pnpm --filter @code-slot/backend dev\"",
    "dev:frontend": "pnpm --filter @code-slot/frontend dev",
    "dev:backend": "pnpm --filter @code-slot/backend dev",
    "build": "pnpm --filter @code-slot/frontend build && pnpm --filter @code-slot/backend build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:logs": "docker compose logs -f",
    "db:generate": "pnpm --filter @code-slot/backend db:generate",
    "db:migrate": "pnpm --filter @code-slot/backend db:migrate",
    "db:studio": "pnpm --filter @code-slot/backend db:studio",
    "doc:pdf": "node scripts/generate_pdf.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^9.20.1",
    "marked": "^18.1.2",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3"
  }
}
